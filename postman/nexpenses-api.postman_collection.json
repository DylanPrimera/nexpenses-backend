{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Nexpenses API",
    "description": "Colección Postman v2.1 para la API NestJS de Nexpenses.\n\n**Base:** `{{baseUrl}}` → `http://localhost:4000/api/v1`\n\n**Auth:** header `X-User-Id` (UUID). Sin JWT.\n\n**Flujo sugerido:**\n1. Health → Create User (guarda `userId` automáticamente)\n2. Create Category (guarda `categoryId`)\n3. Create Expense (guarda `expenseId`)\n4. Summary / History\n\nRate limit: 60 req/min (POST /users: 10/min). Categories: sin DELETE en v1.\n\n**Response envelope:** all responses are `{ success, data, message }`. Errors add `error: { statusCode, code, details? }`. Paginated lists: `data: { items, total, limit, offset }`.\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "value",
        "value": "{{userId}}",
        "type": "string"
      },
      {
        "key": "key",
        "value": "X-User-Id",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "expenseId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Chequeo de salud público (sin X-User-Id ni rate limit).",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Verifica que la API esté viva. Público, sin autenticación ni throttle.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "description": "Crear y gestionar usuario. POST /users no requiere X-User-Id. GET /users lista todos (testing only; requiere X-User-Id; sin emailAppToken).",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Crea usuario (primera visita). No requiere X-User-Id. Rate limit: 10/min. Campos: name (sin espacios, máx 20), budget (COP 10000–100000000), email y emailAppToken opcionales. Guarda `id` en variable `userId`.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dylan\",\n  \"budget\": 2000000,\n  \"email\": \"dylan@example.com\",\n  \"emailAppToken\": \"opaque-app-token\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Envelope success', function () {",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.id) {",
                  "    pm.collectionVariables.set('userId', json.data.id);",
                  "    console.log('userId guardado:', json.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
