generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentType {
  cash
  debit_card
  credit_card
}

model User {
  id                     String                  @id @default(uuid())
  name                   String
  firstName              String                  @default("")
  lastName               String                  @default("")
  budget                 Int                     @default(0)
  cycleStartedAt         DateTime                @default(now())
  email                  String                  @unique
  password               String?
  emailAppToken          String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  categories             Category[]
  expenses               Expense[]
  credits                Credit[]
  recurringExpenses      RecurringExpense[]
  processedInboundEmails ProcessedInboundEmail[]
  keptBusinessAmount         Int                     @default(0)
  keptBusinessCycleStartedAt DateTime?
  business                   Business?
}

enum CreditKind {
  TC
  CONSUMO
}

enum CreditProvider {
  NU
  LULO
  ICETEX
  BANCO_BOGOTA
  BANCOLOMBIA
  DAVIVIENDA
  BBVA
  BANCO_OCCIDENTE
  BANCO_POPULAR
  AV_VILLAS
  CAJA_SOCIAL
  SCOTIABANK_COLPATRIA
  NEQUI
  RAPPICARD
  FALABELLA
  PICHINCHA
  AGRARIO
  SERFINANZA
  BAN100
  IRIS
  GENERIC
}

model Category {
  id         String    @id @default(uuid())
  name       String
  color      String
  usageCount Int       @default(0)
  createdAt  DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses           Expense[]
  recurringExpenses  RecurringExpense[]

  @@unique([userId, name])
  @@index([userId])
}

model Expense {
  id          String      @id @default(uuid())
  amount      Int
  categoryId  String
  title       String
  description String
  paymentType PaymentType
  date        DateTime    @default(now())
  userId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category               Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  credit                 Credit?                 @relation(fields: [creditId], references: [id], onDelete: SetNull)
  processedInboundEmails ProcessedInboundEmail[]
  creditId                   String?
  creditBalanceApplied       Decimal                 @default(0) @db.Decimal(14, 2)
  creditInstallmentAdvanced  Boolean                 @default(false)
  creditDueBefore            DateTime?
  creditDaysPastDueBefore    Int?

  @@index([userId])
  @@index([categoryId])
  @@index([userId, date])
  @@index([creditId])
}


model RecurringExpense {
  id          String      @id @default(uuid())
  amount      Int
  categoryId  String
  title       String
  description String
  paymentType PaymentType
  userId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([categoryId])
}

model Credit {
  id                       String         @id @default(uuid())
  userId                   String
  kind                     CreditKind
  provider                 CreditProvider
  bankName                 String
  displayName              String
  productRef               String?
  cutoffDate               DateTime?
  nextPaymentDate          DateTime?
  paymentDay               Int?
  daysPastDue              Int            @default(0)
  remainingBalance         Decimal        @db.Decimal(14, 2)
  periodInterest           Decimal?       @db.Decimal(14, 2)
  insuranceOrOtherCharges  Decimal?       @db.Decimal(14, 2)
  rateEa                   Decimal?       @db.Decimal(8, 4)
  rateMv                   Decimal?       @db.Decimal(8, 4)
  creditLimit              Decimal?       @db.Decimal(14, 2)
  availableCredit          Decimal?       @db.Decimal(14, 2)
  usedAmount               Decimal?       @db.Decimal(14, 2)
  minPayment               Decimal?       @db.Decimal(14, 2)
  amountDueThisPeriod      Decimal?       @db.Decimal(14, 2)
  installmentAmount        Decimal?       @db.Decimal(14, 2)
  installmentCurrent       Int?
  installmentTotal         Int?
  originalAmount           Decimal?       @db.Decimal(14, 2)
  termMonths               Int?
  installmentType          String?
  stage                    String?
  rawExtract               Json
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  user                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses                 Expense[]

  @@index([userId])
  @@index([userId, nextPaymentDate])
}

model ProcessedInboundEmail {
  id          String   @id @default(uuid())
  messageId   String   @unique
  fingerprint String
  userId      String
  processedAt DateTime @default(now())
  expenseId   String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense     Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([userId, fingerprint])
  @@index([userId])
  @@index([processedAt])
}

enum BusinessPaymentMethod {
  cash
  transfer
}

model Business {
  id        String           @id @default(uuid())
  userId    String           @unique
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes   BusinessIncome[]
}

model BusinessIncome {
  id                    String                @id
  businessId            String
  title                 String
  description           String?
  clientName            String?
  amount                Int
  collectedOn           DateTime              @db.Date
  paymentMethod         BusinessPaymentMethod
  bankName              String?
  addedToCycleStartedAt DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  business              Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, collectedOn])
  @@index([businessId, addedToCycleStartedAt])
}
